# Copy this file to .env and fill in the values below.
# Generate secrets with: openssl rand -base64 32

# Required
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Required: the public https origin Keeper is served from.
# With ngrok ingress this is https://<NGROK_DOMAIN>. Comma-delimited if there's more than one.
TRUSTED_ORIGINS=

# Required: the base URL better-auth uses to build OAuth redirect/callback URLs.
# With ngrok ingress this must be https://<NGROK_DOMAIN> (same as TRUSTED_ORIGINS) —
# otherwise it defaults to http://localhost and OAuth callbacks will be sent there instead.
BETTER_AUTH_URL=

# Required: ngrok ingress (free plan)
# Auth token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Free static domain, reserved at: https://dashboard.ngrok.com/domains
# e.g. your-name.ngrok-free.app (no https:// prefix)
NGROK_DOMAIN=

# Optional: only used by compose.services.yaml (individual-services setup).
# Ignored by compose.yaml (standalone), which always uses "keeper"/"keeper".
POSTGRES_USER=
POSTGRES_DB=

# Optional: overrides the internal Postgres user's password (defaults to "keeper").
# Used by both compose.yaml (standalone) and compose.services.yaml.
POSTGRES_PASSWORD=

# Optional: Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Microsoft Outlook OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: how many months forward of events to sync (defaults to 24, i.e. 2 years).
# Lowering this reduces load/timeouts against provider APIs for calendars with heavy
# recurring-event volume, at the cost of a shorter sync horizon.
SYNC_LOOKAHEAD_MONTHS=24
